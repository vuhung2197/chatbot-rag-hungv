# ai-service config — copy thành .env và điền giá trị thật. KHÔNG commit .env.
ENVIRONMENT=development

# Postgres (dùng chung với backend Node — cùng DB knowledge_chunks)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_DATABASE=chatbot

# Redis (dùng chung)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# LLM
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434

# Web search (Tavily) — cho LIVE_SEARCH / web fallback
TAVILY_API_KEY=

# Node API (gọi ngược cho USER_PROGRESS)
NODE_API_URL=http://localhost:3001

# Allowlist host base_url LLM (chặn SSRF/lộ key qua model.url). CSV.
ALLOWED_LLM_HOSTS=api.openai.com,localhost,127.0.0.1,ollama
# Shared-secret: nếu đặt, /chat & /chat/stream yêu cầu header X-Internal-Token khớp.
INTERNAL_API_TOKEN=
